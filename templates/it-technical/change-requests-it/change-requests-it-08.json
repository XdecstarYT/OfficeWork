{
  "id": "change-requests-it-08",
  "category": "IT & Technical",
  "categoryId": "it-technical",
  "subcategory": "Change Requests",
  "subcategoryId": "change-requests-it",
  "title": "Emergency IT Change Request",
  "description": "An emergency it change request — requests approval for a change to systems or infrastructure.",
  "estimatedMinutes": 18,
  "difficulty": "standard",
  "tags": [
    "change",
    "request",
    "emergency",
    "change requests it"
  ],
  "fields": [
    {
      "id": "subject_name",
      "label": "Requested By",
      "type": "text",
      "required": true
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "department",
      "label": "Department",
      "type": "select",
      "required": false,
      "options": [
        "Sales",
        "Marketing",
        "Engineering",
        "Finance",
        "Human Resources",
        "Operations",
        "Customer Support",
        "Executive"
      ]
    },
    {
      "id": "system",
      "label": "System / Service",
      "type": "text",
      "required": true
    },
    {
      "id": "planned_date",
      "label": "Planned Change Date",
      "type": "date",
      "required": false
    },
    {
      "id": "details",
      "label": "Description of Change",
      "type": "textarea",
      "required": true
    },
    {
      "id": "approver_name",
      "label": "Change Approver",
      "type": "text",
      "required": true
    },
    {
      "id": "signature",
      "label": "Signature",
      "type": "signature",
      "required": true
    }
  ],
  "bodyTemplate": "IT CHANGE REQUEST\nEmergency Change — requests approval for a change to systems or infrastructure.\nRequested By: {{subject_name}}          Date: {{date}}\nDepartment: {{department}}              System / Service: {{system}}\nPlanned Change Date: {{planned_date}}\n\n--------------------------------------------------------------------\n\n{{details}}\n--------------------------------------------------------------------\n\nApprover: {{approver_name}}\n\nSignature: {{signature}}"
}
