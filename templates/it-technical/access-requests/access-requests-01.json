{
  "id": "access-requests-01",
  "category": "IT & Technical",
  "categoryId": "it-technical",
  "subcategory": "Access Request Forms",
  "subcategoryId": "access-requests",
  "title": "New Hire Access Request Form",
  "description": "A new hire access request form — requests access to a system, application, or facility.",
  "estimatedMinutes": 12,
  "difficulty": "standard",
  "tags": [
    "access",
    "request",
    "new",
    "access requests"
  ],
  "fields": [
    {
      "id": "subject_name",
      "label": "Requested For",
      "type": "text",
      "required": true
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "department",
      "label": "Department",
      "type": "select",
      "required": false,
      "options": [
        "Sales",
        "Marketing",
        "Engineering",
        "Finance",
        "Human Resources",
        "Operations",
        "Customer Support",
        "Executive"
      ]
    },
    {
      "id": "system_requested",
      "label": "System / Resource",
      "type": "text",
      "required": true
    },
    {
      "id": "access_level",
      "label": "Access Level",
      "type": "select",
      "required": false,
      "options": [
        "Read-Only",
        "Standard",
        "Admin",
        "Temporary"
      ]
    },
    {
      "id": "details",
      "label": "Business Justification",
      "type": "textarea",
      "required": true
    },
    {
      "id": "approver_name",
      "label": "System Owner",
      "type": "text",
      "required": true
    },
    {
      "id": "signature",
      "label": "Signature",
      "type": "signature",
      "required": true
    }
  ],
  "bodyTemplate": "ACCESS REQUEST FORM\nNew Hire — requests access to a system, application, or facility.\nRequested For: {{subject_name}}         Date: {{date}}\nDepartment: {{department}}              System / Resource: {{system_requested}}\nAccess Level: {{access_level}}\n\n--------------------------------------------------------------------\n\n{{details}}\n--------------------------------------------------------------------\n\nApprover: {{approver_name}}\n\nSignature: {{signature}}"
}
