{
  "id": "incident-reports-it-01",
  "category": "IT & Technical",
  "categoryId": "it-technical",
  "subcategory": "IT Incident Reports",
  "subcategoryId": "incident-reports-it",
  "title": "Server Outage IT Incident Report",
  "description": "A server outage it incident report — documents a technical incident, its impact, and resolution.",
  "estimatedMinutes": 12,
  "difficulty": "standard",
  "tags": [
    "incident",
    "report",
    "server",
    "incident reports it"
  ],
  "fields": [
    {
      "id": "subject_name",
      "label": "Reported By",
      "type": "text",
      "required": true
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "department",
      "label": "Department",
      "type": "select",
      "required": false,
      "options": [
        "Sales",
        "Marketing",
        "Engineering",
        "Finance",
        "Human Resources",
        "Operations",
        "Customer Support",
        "Executive"
      ]
    },
    {
      "id": "severity",
      "label": "Severity",
      "type": "select",
      "required": true,
      "options": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ]
    },
    {
      "id": "system_affected",
      "label": "System Affected",
      "type": "text",
      "required": true
    },
    {
      "id": "details",
      "label": "Description & Resolution",
      "type": "textarea",
      "required": true
    },
    {
      "id": "approver_name",
      "label": "IT Lead",
      "type": "text",
      "required": true
    },
    {
      "id": "signature",
      "label": "Signature",
      "type": "signature",
      "required": true
    }
  ],
  "bodyTemplate": "IT INCIDENT REPORT\nServer Outage — documents a technical incident, its impact, and resolution.\nReported By: {{subject_name}}           Date: {{date}}\nDepartment: {{department}}              Severity: {{severity}}\nSystem Affected: {{system_affected}}\n\n--------------------------------------------------------------------\n\n{{details}}\n--------------------------------------------------------------------\n\nApprover: {{approver_name}}\n\nSignature: {{signature}}"
}
