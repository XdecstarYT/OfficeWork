{
  "id": "bug-reports-05",
  "category": "IT & Technical",
  "categoryId": "it-technical",
  "subcategory": "Bug & Defect Reports",
  "subcategoryId": "bug-reports",
  "title": "Security Vulnerability Bug Report",
  "description": "A security vulnerability bug report — documents a software defect for the engineering team to triage.",
  "estimatedMinutes": 12,
  "difficulty": "standard",
  "tags": [
    "report",
    "security",
    "bug reports"
  ],
  "fields": [
    {
      "id": "subject_name",
      "label": "Reported By",
      "type": "text",
      "required": true
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "department",
      "label": "Department",
      "type": "select",
      "required": false,
      "options": [
        "Sales",
        "Marketing",
        "Engineering",
        "Finance",
        "Human Resources",
        "Operations",
        "Customer Support",
        "Executive"
      ]
    },
    {
      "id": "severity",
      "label": "Severity",
      "type": "select",
      "required": true,
      "options": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ]
    },
    {
      "id": "steps_to_reproduce",
      "label": "Steps to Reproduce",
      "type": "textarea",
      "required": false
    },
    {
      "id": "details",
      "label": "Description",
      "type": "textarea",
      "required": true
    },
    {
      "id": "approver_name",
      "label": "Engineering Lead",
      "type": "text",
      "required": true
    },
    {
      "id": "signature",
      "label": "Signature",
      "type": "signature",
      "required": true
    }
  ],
  "bodyTemplate": "BUG REPORT\nSecurity Vulnerability — documents a software defect for the engineering team to triage.\nReported By: {{subject_name}}           Date: {{date}}\nDepartment: {{department}}              Severity: {{severity}}\n\n--------------------------------------------------------------------\nSteps to Reproduce:\n{{steps_to_reproduce}}\n{{details}}\n--------------------------------------------------------------------\n\nApprover: {{approver_name}}\n\nSignature: {{signature}}"
}
