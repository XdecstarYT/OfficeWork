    { "id": "date", "label": "Date", "type": "date", "required": true },
    { "id": "recipient_name", "label": "Recipient Name", "type": "text", "required": false, "placeholder": "Optional" },
    { "id": "recipient_address", "label": "Recipient Address", "type": "textarea", "required": false, "placeholder": "Optional" },
    { "id": "salutation", "label": "Salutation", "type": "text", "required": false, "placeholder": "Dear ___," },
    { "id": "body", "label": "Letter Body", "type": "textarea", "required": true, "placeholder": "Write your letter here." },
    { "id": "closing", "label": "Closing", "type": "text", "required": false, "placeholder": "Sincerely," },
    { "id": "signature", "label": "Signature", "type": "signature", "required": false }
