  "bodyTemplate": "{{date}}\n\n{{recipient_name}}\n{{recipient_address}}\n\n{{salutation}}\n\n{{body}}\n\n{{closing}}\n\n{{signature}}\n{{sender_name}}\n{{sender_title}}"
