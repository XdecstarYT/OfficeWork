  "bodyTemplate": "MEMORANDUM\n\nTo: {{to}}\nFrom: {{from}}\nDate: {{date}}\nRe: {{subject}}\nDate & Time: {{meeting_time}}           Location / Link: {{location}}\n\n--------------------------------------------------------------------\n\nAgenda:\n{{agenda}}\n{{body}}"
