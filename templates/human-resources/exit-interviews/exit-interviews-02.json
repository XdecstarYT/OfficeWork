{
  "id": "exit-interviews-02",
  "category": "Human Resources",
  "categoryId": "human-resources",
  "subcategory": "Exit Interviews & Offboarding",
  "subcategoryId": "exit-interviews",
  "title": "Involuntary Exit Interview",
  "description": "An involuntary exit interview — captures a departing employee's feedback and offboarding details.",
  "estimatedMinutes": 14,
  "difficulty": "standard",
  "tags": [
    "exit",
    "interview",
    "involuntary",
    "exit interviews"
  ],
  "fields": [
    {
      "id": "subject_name",
      "label": "Employee Name",
      "type": "text",
      "required": true
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "department",
      "label": "Department",
      "type": "select",
      "required": false,
      "options": [
        "Sales",
        "Marketing",
        "Engineering",
        "Finance",
        "Human Resources",
        "Operations",
        "Customer Support",
        "Executive"
      ]
    },
    {
      "id": "last_day",
      "label": "Last Day of Employment",
      "type": "date",
      "required": true
    },
    {
      "id": "reason_for_leaving",
      "label": "Reason for Leaving",
      "type": "select",
      "required": true,
      "options": [
        "New Opportunity",
        "Relocation",
        "Compensation",
        "Management",
        "Career Change",
        "Retirement",
        "Other"
      ]
    },
    {
      "id": "details",
      "label": "Feedback",
      "type": "textarea",
      "required": true
    },
    {
      "id": "approver_name",
      "label": "HR Representative",
      "type": "text",
      "required": true
    },
    {
      "id": "signature",
      "label": "Signature",
      "type": "signature",
      "required": true
    }
  ],
  "bodyTemplate": "EXIT INTERVIEW\nInvoluntary — captures a departing employee's feedback and offboarding details.\nEmployee Name: {{subject_name}}         Date: {{date}}\nDepartment: {{department}}              Last Day of Employment: {{last_day}}\nReason for Leaving: {{reason_for_leaving}}\n\n--------------------------------------------------------------------\n\n{{details}}\n--------------------------------------------------------------------\n\nApprover: {{approver_name}}\n\nSignature: {{signature}}"
}
