{
  "id": "benefits-enrollment-05",
  "category": "Human Resources",
  "categoryId": "human-resources",
  "subcategory": "Benefits Enrollment",
  "subcategoryId": "benefits-enrollment",
  "title": "Plan Upgrade Benefits Enrollment Form",
  "description": "A plan upgrade benefits enrollment form — enrolls or updates an employee's benefits elections.",
  "estimatedMinutes": 12,
  "difficulty": "standard",
  "tags": [
    "benefits",
    "enrollment",
    "plan",
    "benefits enrollment"
  ],
  "fields": [
    {
      "id": "subject_name",
      "label": "Employee Name",
      "type": "text",
      "required": true
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "department",
      "label": "Department",
      "type": "select",
      "required": false,
      "options": [
        "Sales",
        "Marketing",
        "Engineering",
        "Finance",
        "Human Resources",
        "Operations",
        "Customer Support",
        "Executive"
      ]
    },
    {
      "id": "plan_type",
      "label": "Plan Type",
      "type": "select",
      "required": true,
      "options": [
        "Medical",
        "Dental",
        "Vision",
        "401(k)",
        "Life Insurance",
        "FSA/HSA",
        "Other"
      ]
    },
    {
      "id": "effective_date",
      "label": "Effective Date",
      "type": "date",
      "required": true
    },
    {
      "id": "details",
      "label": "Elections / Notes",
      "type": "textarea",
      "required": true
    },
    {
      "id": "approver_name",
      "label": "Benefits Administrator",
      "type": "text",
      "required": true
    },
    {
      "id": "signature",
      "label": "Signature",
      "type": "signature",
      "required": true
    }
  ],
  "bodyTemplate": "BENEFITS ENROLLMENT FORM\nPlan Upgrade — enrolls or updates an employee's benefits elections.\nEmployee Name: {{subject_name}}         Date: {{date}}\nDepartment: {{department}}              Plan Type: {{plan_type}}\nEffective Date: {{effective_date}}\n\n--------------------------------------------------------------------\n\n{{details}}\n--------------------------------------------------------------------\n\nApprover: {{approver_name}}\n\nSignature: {{signature}}"
}
