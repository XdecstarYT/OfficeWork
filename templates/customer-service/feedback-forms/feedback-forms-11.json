{
  "id": "feedback-forms-11",
  "category": "Customer Service",
  "categoryId": "customer-service",
  "subcategory": "Feedback Collection Forms",
  "subcategoryId": "feedback-forms",
  "title": "Feedback Collection Form",
  "description": "Collects general customer feedback about the product or experience.",
  "estimatedMinutes": 16,
  "difficulty": "standard",
  "tags": [
    "feedback",
    "collection",
    "general",
    "feedback forms"
  ],
  "fields": [
    {
      "id": "subject_name",
      "label": "Customer Name (Optional)",
      "type": "text",
      "required": true
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "feedback_category",
      "label": "Category",
      "type": "select",
      "required": false,
      "options": [
        "Product",
        "Service",
        "Website",
        "Pricing",
        "Support",
        "Other"
      ]
    },
    {
      "id": "details",
      "label": "Feedback",
      "type": "textarea",
      "required": true
    },
    {
      "id": "approver_name",
      "label": "Reviewed By",
      "type": "text",
      "required": true
    },
    {
      "id": "signature",
      "label": "Signature",
      "type": "signature",
      "required": true
    }
  ],
  "bodyTemplate": "FEEDBACK COLLECTION FORM\n\nCustomer Name (Optional): {{subject_name}}Date: {{date}}\nCategory: {{feedback_category}}\n\n--------------------------------------------------------------------\n\n{{details}}\n--------------------------------------------------------------------\n\nApprover: {{approver_name}}\n\nSignature: {{signature}}"
}
