{
  "id": "apology-letters-10",
  "category": "Customer Service",
  "categoryId": "customer-service",
  "subcategory": "Apology Letters",
  "subcategoryId": "apology-letters",
  "title": "Public Incident Apology Letter",
  "description": "A public incident apology letter — formally apologizes to a customer for a service failure.",
  "estimatedMinutes": 10,
  "difficulty": "quick",
  "tags": [
    "apology",
    "letter",
    "public",
    "apology letters"
  ],
  "fields": [
    {
      "id": "sender_name",
      "label": "Your Name",
      "type": "text",
      "required": true,
      "placeholder": "Your name"
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "recipient_name",
      "label": "Recipient Name",
      "type": "text",
      "required": true
    },
    {
      "id": "issue_summary",
      "label": "What Went Wrong",
      "type": "textarea",
      "required": false
    },
    {
      "id": "details",
      "label": "Message",
      "type": "textarea",
      "required": true,
      "placeholder": "Write the body of the letter here."
    },
    {
      "id": "signature",
      "label": "Signature",
      "type": "signature",
      "required": true
    }
  ],
  "bodyTemplate": "{{date}}\n\n{{recipient_name}}\n\nDear {{recipient_name}},\n\nWhat Went Wrong:\n{{issue_summary}}\n{{details}}\n\nSincerely,\n\n{{signature}}\n{{sender_name}}"
}
