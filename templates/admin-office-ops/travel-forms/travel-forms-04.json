{
  "id": "travel-forms-04",
  "category": "Administrative & Office Operations",
  "categoryId": "admin-office-ops",
  "subcategory": "Travel Request & Expense Forms",
  "subcategoryId": "travel-forms",
  "title": "Conference Travel Request Form",
  "description": "A conference travel request form — requests approval to book business travel.",
  "estimatedMinutes": 18,
  "difficulty": "standard",
  "tags": [
    "travel",
    "request",
    "conference",
    "travel forms"
  ],
  "fields": [
    {
      "id": "subject_name",
      "label": "Traveler Name",
      "type": "text",
      "required": true
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "department",
      "label": "Department",
      "type": "select",
      "required": false,
      "options": [
        "Sales",
        "Marketing",
        "Engineering",
        "Finance",
        "Human Resources",
        "Operations",
        "Customer Support",
        "Executive"
      ]
    },
    {
      "id": "destination",
      "label": "Destination",
      "type": "text",
      "required": true
    },
    {
      "id": "travel_dates",
      "label": "Travel Dates",
      "type": "text",
      "required": false
    },
    {
      "id": "details",
      "label": "Purpose of Travel",
      "type": "textarea",
      "required": true
    },
    {
      "id": "approver_name",
      "label": "Manager",
      "type": "text",
      "required": true
    },
    {
      "id": "signature",
      "label": "Signature",
      "type": "signature",
      "required": true
    }
  ],
  "bodyTemplate": "TRAVEL REQUEST FORM\nConference — requests approval to book business travel.\nTraveler Name: {{subject_name}}         Date: {{date}}\nDepartment: {{department}}              Destination: {{destination}}\nTravel Dates: {{travel_dates}}\n\n--------------------------------------------------------------------\n\n{{details}}\n--------------------------------------------------------------------\n\nApprover: {{approver_name}}\n\nSignature: {{signature}}"
}
