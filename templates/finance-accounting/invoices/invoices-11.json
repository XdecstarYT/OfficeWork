  "bodyTemplate": "INVOICE\n\nBill To:\n{{counterparty}}\n\nDate: {{date}}                          Due Date: {{due_date}}\nInvoice #: {{invoice_number}}\n\n--------------------------------------------------------------------\n{{line_items}}\n--------------------------------------------------------------------\n\nTOTAL: {{total}}"
