{
  "id": "payroll-forms-09",
  "category": "Finance & Accounting",
  "categoryId": "finance-accounting",
  "subcategory": "Payroll Forms",
  "subcategoryId": "payroll-forms",
  "title": "Garnishment Payroll Adjustment Form",
  "description": "A garnishment payroll adjustment form — documents a change to an employee's payroll processing.",
  "estimatedMinutes": 12,
  "difficulty": "standard",
  "tags": [
    "payroll",
    "adjustment",
    "garnishment",
    "payroll forms"
  ],
  "fields": [
    {
      "id": "subject_name",
      "label": "Employee Name",
      "type": "text",
      "required": true
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "department",
      "label": "Department",
      "type": "select",
      "required": false,
      "options": [
        "Sales",
        "Marketing",
        "Engineering",
        "Finance",
        "Human Resources",
        "Operations",
        "Customer Support",
        "Executive"
      ]
    },
    {
      "id": "effective_date",
      "label": "Effective Date",
      "type": "date",
      "required": true
    },
    {
      "id": "adjustment_type",
      "label": "Adjustment Type",
      "type": "select",
      "required": true,
      "options": [
        "Salary Change",
        "Bonus",
        "Correction",
        "Deduction Change",
        "Direct Deposit Update",
        "Other"
      ]
    },
    {
      "id": "details",
      "label": "Details",
      "type": "textarea",
      "required": true
    },
    {
      "id": "approver_name",
      "label": "Payroll Manager",
      "type": "text",
      "required": true
    },
    {
      "id": "signature",
      "label": "Signature",
      "type": "signature",
      "required": true
    }
  ],
  "bodyTemplate": "PAYROLL ADJUSTMENT FORM\nGarnishment — documents a change to an employee's payroll processing.\nEmployee Name: {{subject_name}}         Date: {{date}}\nDepartment: {{department}}              Effective Date: {{effective_date}}\nAdjustment Type: {{adjustment_type}}\n\n--------------------------------------------------------------------\n\n{{details}}\n--------------------------------------------------------------------\n\nApprover: {{approver_name}}\n\nSignature: {{signature}}"
}
