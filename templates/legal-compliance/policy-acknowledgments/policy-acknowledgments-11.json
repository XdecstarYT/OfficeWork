{
  "id": "policy-acknowledgments-11",
  "category": "Legal & Compliance",
  "categoryId": "legal-compliance",
  "subcategory": "Policy Acknowledgments",
  "subcategoryId": "policy-acknowledgments",
  "title": "Policy Acknowledgment",
  "description": "Documents that an employee has read and agreed to a company policy.",
  "estimatedMinutes": 16,
  "difficulty": "standard",
  "tags": [
    "policy",
    "acknowledgment",
    "general",
    "policy acknowledgments"
  ],
  "fields": [
    {
      "id": "subject_name",
      "label": "Employee Name",
      "type": "text",
      "required": true
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "department",
      "label": "Department",
      "type": "select",
      "required": false,
      "options": [
        "Sales",
        "Marketing",
        "Engineering",
        "Finance",
        "Human Resources",
        "Operations",
        "Customer Support",
        "Executive"
      ]
    },
    {
      "id": "policy_name",
      "label": "Policy Name",
      "type": "text",
      "required": true
    },
    {
      "id": "details",
      "label": "Acknowledgment Statement",
      "type": "textarea",
      "required": true
    },
    {
      "id": "approver_name",
      "label": "HR Representative",
      "type": "text",
      "required": true
    },
    {
      "id": "signature",
      "label": "Signature",
      "type": "signature",
      "required": true
    }
  ],
  "bodyTemplate": "POLICY ACKNOWLEDGMENT\n\nEmployee Name: {{subject_name}}         Date: {{date}}\nDepartment: {{department}}              Policy Name: {{policy_name}}\n\n--------------------------------------------------------------------\n\n{{details}}\n--------------------------------------------------------------------\n\nApprover: {{approver_name}}\n\nSignature: {{signature}}"
}
