{
  "id": "change-requests-pm-11",
  "category": "Project Management",
  "categoryId": "project-management",
  "subcategory": "Project Change Requests",
  "subcategoryId": "change-requests-pm",
  "title": "Project Change Request",
  "description": "Requests a change to project scope, schedule, or budget.",
  "estimatedMinutes": 16,
  "difficulty": "standard",
  "tags": [
    "project",
    "change",
    "general",
    "change requests pm"
  ],
  "fields": [
    {
      "id": "subject_name",
      "label": "Requested By",
      "type": "text",
      "required": true
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "department",
      "label": "Department",
      "type": "select",
      "required": false,
      "options": [
        "Sales",
        "Marketing",
        "Engineering",
        "Finance",
        "Human Resources",
        "Operations",
        "Customer Support",
        "Executive"
      ]
    },
    {
      "id": "impact",
      "label": "Impact on Scope/Schedule/Budget",
      "type": "textarea",
      "required": false
    },
    {
      "id": "details",
      "label": "Reason for Change",
      "type": "textarea",
      "required": true
    },
    {
      "id": "approver_name",
      "label": "Project Sponsor",
      "type": "text",
      "required": true
    },
    {
      "id": "signature",
      "label": "Signature",
      "type": "signature",
      "required": true
    }
  ],
  "bodyTemplate": "PROJECT CHANGE REQUEST\n\nRequested By: {{subject_name}}          Date: {{date}}\nDepartment: {{department}}\n\n--------------------------------------------------------------------\nImpact on Scope/Schedule/Budget:\n{{impact}}\n{{details}}\n--------------------------------------------------------------------\n\nApprover: {{approver_name}}\n\nSignature: {{signature}}"
}
