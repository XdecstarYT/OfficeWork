  "bodyTemplate": "REQUEST FOR PROPOSAL\n\nPrepared By: {{author}}                 Date: {{date}}\nReporting Period: {{period}}            Submission Deadline: {{submission_deadline}}\n\n--------------------------------------------------------------------\n\nProject Scope:\n{{project_scope}}\n{{summary}}"
